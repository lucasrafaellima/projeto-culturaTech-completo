# Copie para .env e preencha. O .env NÃO vai para o git.

# Conexão com o PostgreSQL (RDS). Os nomes PG* são lidos direto pelo driver pg.
PGHOST=culturatech-db.xxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=culturatech
PGUSER=postgres
PGPASSWORD=troque-esta-senha

# SSL: disable (banco local) | require (cifra, sem conferir o certificado) | verify (cifra e confere)
DB_SSL=require
# Só para DB_SSL=verify: caminho do bundle de CA da AWS (global-bundle.pem)
# DB_SSL_CA=./global-bundle.pem

# Segredo para assinar os tokens. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRA_EM=8h

PORT=3333

# Onde ficam os arquivos (digitalizações, fotos 3x4, imagens de dano):
#   s3    -> Amazon S3 (produção)
#   disco -> pasta server/uploads (desenvolvimento, sem AWS)
ARMAZENAMENTO=s3
S3_BUCKET=culturatech-arquivos
S3_REGIAO=us-east-1
# Opcional: serviço compatível com S3 (MinIO etc.)
# S3_ENDPOINT=http://localhost:9000
# Credenciais: a cadeia padrão da AWS (papel IAM da instância, perfil ~/.aws ou as variáveis abaixo)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Só para ARMAZENAMENTO=disco (padrão: server/uploads)
# PASTA_UPLOADS=./uploads
