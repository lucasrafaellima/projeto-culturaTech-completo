# Copie para .env e preencha. O .env NÃO vai para o git.

# Conexão com o PostgreSQL (Neon). Os nomes PG* são lidos direto pelo driver pg.
# Use a conexão direta: em Connect, com "Connection pooling" desligado (sem "-pooler" no host).
PGHOST=ep-xxxx.us-east-1.aws.neon.tech
PGPORT=5432
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=troque-esta-senha

# SSL: disable (banco local) | require (cifra, sem conferir o certificado) | verify (cifra e confere)
DB_SSL=require
# Só para DB_SSL=verify: caminho do arquivo de CA
# DB_SSL_CA=./ca.pem

# Segredo para assinar os tokens. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRA_EM=8h

PORT=3333

# Fuso dos turnos das mesas de estudo (padrão: America/Maceio, o horário de Arapiraca)
# FUSO_HORARIO=America/Maceio

# Onde ficam os arquivos (digitalizações, fotos 3x4, imagens de dano):
#   s3    -> bucket do Neon Object Storage (Connect > Storage > Parameters only)
#   disco -> pasta server/uploads (desenvolvimento)
ARMAZENAMENTO=s3
S3_BUCKET=culturatech-arquivos
# S3_REGIAO = AWS_REGION e S3_ENDPOINT = AWS_ENDPOINT_URL_S3 do Neon
S3_REGIAO=us-east-1
S3_ENDPOINT=https://xxxx.storage.us-east-1.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Só para ARMAZENAMENTO=disco (padrão: server/uploads)
# PASTA_UPLOADS=./uploads
